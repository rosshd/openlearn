          "interface": {
            "kind": "function",
            "function": "pair_sum_sorted",
            "parameters": ["values", "target"]
          },
          "starter_code": "def pair_sum_sorted(values, target):\n    pass\n",
          "reference": "openlearn.interview_problem_references:pair_sum_sorted",
          "tests": {
            "public": [
              {"args": [[1, 4, 7, 9], 10], "kwargs": {}, "expected": [0, 3]},
              {"args": [[-5, -1, 3, 8], 2], "kwargs": {}, "expected": [1, 2]}
            ],
            "hidden": [
              {"args": [[], 5], "kwargs": {}, "expected": [-1, -1]},
              {"args": [[2, 2], 4], "kwargs": {}, "expected": [0, 1]},
              {"args": [[1, 2, 4], 20], "kwargs": {}, "expected": [-1, -1]}
            ]
          }
        }
      },
      "difficulty": "foundation",
      "expected_minutes": 20,
      "skills": [
        {"skill_id": "pattern.two-pointers", "role": "primary"},
