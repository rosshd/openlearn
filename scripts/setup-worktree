#!/usr/bin/env bash
set -euo pipefail
if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--browser" ]; }; then
  echo 'usage: scripts/setup-worktree [--browser]' >&2
  exit 2
fi
cd "$(dirname "$0")/.."
command -v uv >/dev/null || { echo 'Install uv, then rerun scripts/setup-worktree.' >&2; exit 2; }
if [ ! -d .venv ]; then
  uv venv --python '>=3.11,<3.14' .venv
fi
uv pip install --python .venv/bin/python -e '.[dev]'
if [ "${1:-}" = "--browser" ]; then
  .venv/bin/python -m playwright install chromium
fi
echo 'Ready: make check; make qa-smoke'
